# ==============================================================================
# ANVAYA HEALTHCARE PLATFORM - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure all variables appropriately for your deployment.
# NEVER commit production .env files containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Anvaya API"
API_V1_PREFIX="/api/v1"

# Allowed CORS origins (comma-separated list without trailing slashes)
# In production, restrict to your verified frontend domain(s)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://anvaya.yourdomain.com"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL format:
# postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
# For local development:
DATABASE_URL="postgresql+psycopg://anvaya_app:your_secure_db_password@127.0.0.1:5432/anvaya_db"

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a cryptographically secure random secret (min 64 chars):
# openssl rand -base64 64
JWT_SECRET_KEY="REPLACE_WITH_LONG_RANDOM_SECRET_KEY_FOR_PRODUCTION_MIN_64_CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# 4. FIREBASE AUTHENTICATION (OPTIONAL / SOCIAL LOGIN)
# ------------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_PATH="secrets/firebase-service-account.json"

# ------------------------------------------------------------------------------
# 5. AI / SKIN-LESION INFERENCE SETTINGS
# ------------------------------------------------------------------------------
# Path to pre-trained EfficientNet-B0 model checkpoint and config
SKIN_LESION_MODEL_PATH="models/anvaya_skin_lesion_efficientnet_b0_v1.pth"
SKIN_LESION_CONFIG_PATH="models/anvaya_model_config_v1.json"

# Directory for persisting uploaded lesion images (ensure filesystem write permissions)
SKIN_LESION_UPLOAD_DIR="uploads/skin_lesion"

# ------------------------------------------------------------------------------
# 6. REDIS & RATE LIMITING
# ------------------------------------------------------------------------------
# Redis connection URL for distributed rate limiting & ephemeral cache
# If Redis is unavailable, the application falls back gracefully to in-memory store
REDIS_URL="redis://127.0.0.1:6379/0"

# Rate limiting master toggle (true for production, can be disabled during pytest)
RATE_LIMIT_ENABLED=true

# Sliding-window rate limit definitions (format: "<count>/<minute|hour>")
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_AI_INFERENCE="20/minute"
